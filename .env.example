# Скопіюйте у файл .env і заповніть. Файл .env НЕ комітиться (є в .gitignore).
GROQ_API_KEY=gsk_ваш_ключ_з_console.groq.com
GEN_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=openai/gpt-oss-20b
# ключі API чат-бота: ключ:роль (ролі: public, analyst)
API_KEYS=pub-demo-123:public,ana-demo-456:analyst
RATE_LIMIT=10
# необов'язково: Neo4j (Desktop: bolt://localhost:7687; AuraDB: neo4j+s://xxxx.databases.neo4j.io)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=пароль
